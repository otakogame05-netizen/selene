{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Selene",
  "version": "0.20.0",
  "identifier": "com.yomi.reader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Selene",
        "width": 1280,
        "height": 860,
        "minWidth": 680,
        "minHeight": 560,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Sua biblioteca local de mangás",
    "category": "Entertainment",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "resources/suwayomi/": "suwayomi/"
    }
  },
  "mainBinaryName": "Selene"
}

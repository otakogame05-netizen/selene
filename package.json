{
  "name": "yomi-reader",
  "private": true,
  "version": "0.20.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:ui": "node tests/ui.mjs",
    "test:online-ui": "node tests/online-ui.mjs",
    "test:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Smoke.ps1",
    "test:recovery": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Testar-Recuperacao.ps1",
    "test:auth": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Testar-Recuperacao.ps1 -BasicAuth",
    "deliver": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Entregar.ps1",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Verificar.ps1",
    "tauri": "tauri",
    "desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Nativo.ps1 -Action dev",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Nativo.ps1 -Action build",
    "test:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Nativo.ps1 -Action test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "playwright": "^1.51.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@11.25.0"
}






